global:
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "__SMTP_USER__"
  smtp_auth_username: "__SMTP_USER__"
  smtp_auth_password_file: /tmp/smtp_password   # written by entrypoint.sh, never in the image
  smtp_require_tls: true
  resolve_timeout: 5m

route:
  receiver: team-email
  group_by: [alertname, env]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h
  routes:
    - matchers: ['severity="critical"']
      receiver: team-email
      group_wait: 5s
      repeat_interval: 1h

receivers:
  - name: team-email
    email_configs:
      - to: "__ALERT_EMAIL_TO__"
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} - {{ .CommonLabels.env }} ({{ .CommonLabels.severity }})'

# If the whole app is down, do not also spam "metrics target down" for the same environment.
inhibit_rules:
  - source_matchers: ['alertname="CSAppDown"']
    target_matchers: ['alertname="CSMetricsTargetDown"']
    equal: [env]

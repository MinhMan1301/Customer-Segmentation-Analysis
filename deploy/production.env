# Production: full dataset from GitHub Release dataset-v1 (verified by ci/fetch_dataset.sh).
APP_ENV=production
APP_PORT=8501
DATA_DIR=/data/dataset-v1
MEM_LIMIT=6g
CPUS=2.0
# e2e: must be far above the sample size (max 80k) -> proves the full dataset is served
E2E_MIN_DATASET_ROWS=100000
E2E_TIMEOUT=900

# Scripts run inside Linux containers: force LF even when the repo is cloned on Windows.
* text=auto
*.sh text eol=lf
*.py text eol=lf
Jenkinsfile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.tmpl text eol=lf
*.env text eol=lf
*.sha256 text eol=lf
*.csv text eol=lf
*.png binary
*.pdf binary
*.gz binary
